# syntax=docker/dockerfile:1
#
# SchoolCore frontend — production multi-stage build.
#
# Service name (set in compose): schoolcore-frontend
# Internal listener: port 80
# Cloudflare route: https://schoolcore.ooflowdesk.com -> http://schoolcore-frontend:80
#
# NOTHING IS DEPLOYED BY BUILDING THIS IMAGE. Build it, then start it
# deliberately in Phase 5B.
#
# SECURITY:
#   - The repository's .env / .env.* are excluded by .dockerignore and are
#     NEVER copied into any stage. Only VITE_* build args are used, which are
#     public-by-design browser values.
#   - No secret, admin key, or infrastructure credential is present in either
#     stage. RESEND_API_KEY, JWT_PRIVATE_KEY, JWKS, INSTANCE_SECRET,
#     POSTGRES_PASSWORD and CONVEX_SELF_HOSTED_ADMIN_KEY are server-side only
#     and have no path into this image.
#   - Base images are pinned by immutable digest. Do not replace with :latest.

# linux/amd64 digests resolved 2026-09-27 (gman-02 is amd64).
ARG BUN_IMAGE=oven/bun:1-alpine@sha256:d888c0ae6c86d7866ff10c5aafdd9077b36aee6455b33dd270fb93c0dd5cef6f
ARG NGINX_IMAGE=nginx:1.29-alpine@sha256:5616878291a2eed594aee8db4dade5878cf7edcb475e59193904b198d9b830de

# ---------------------------------------------------------------------------
# Stage 1 — build
# ---------------------------------------------------------------------------
FROM ${BUN_IMAGE} AS build

WORKDIR /app

# Manifests first so dependency install is cached independently of source edits.
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

# Source. .dockerignore keeps .env*, node_modules, backups and docs out.
COPY . .

# Build-time, public-by-nature values only.
# Self-hosted values:
#   VITE_CONVEX_URL=https://schoolcore-api.ooflowdesk.com
ARG VITE_CONVEX_URL
ARG VITE_VLY_APP_ID=""
ARG VITE_VLY_MONITORING_URL=""
ENV VITE_CONVEX_URL=${VITE_CONVEX_URL} \
    VITE_VLY_APP_ID=${VITE_VLY_APP_ID} \
    VITE_VLY_MONITORING_URL=${VITE_VLY_MONITORING_URL}

RUN bun run build

# ---------------------------------------------------------------------------
# Stage 2 — runtime
# ---------------------------------------------------------------------------
FROM ${NGINX_IMAGE} AS runtime

# Replace the stock site config with the hardened SPA config.
RUN rm -f /etc/nginx/conf.d/default.conf
COPY deploy/nginx-frontend.conf /etc/nginx/conf.d/default.conf

# Only the built output crosses the stage boundary.
COPY --from=build /app/dist /usr/share/nginx/html

# Cache-bust the container so a new image is a new layer.
LABEL org.opencontainers.image.title="schoolcore-frontend"

EXPOSE 80

# Serve /healthz from nginx itself (no process spawn per check).
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1/healthz || exit 1

# nginx: the master process binds :80 and workers run as the unprivileged
# `nginx` user (worker_processes/user are set in the shipped config).
# In compose this service additionally runs with cap_drop: ALL plus
# read-only root filesystem and no published host port.
CMD ["nginx", "-g", "daemon off;"]
