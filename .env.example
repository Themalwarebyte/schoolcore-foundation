# SchoolCore environment template — PLACEHOLDERS ONLY
#
# Never commit a real value here. This file is the tracked template.
# `.env` and `.env.*` are gitignored (only `.env.example` is tracked).
#
# This file covers APP variables only. Docker/infrastructure secrets
# (CONVEX_SELF_HOSTED_ADMIN_KEY, INSTANCE_SECRET, POSTGRES_PASSWORD,
#  TUNNEL_TOKEN) live ONLY in the server-side protected file
# /opt/schoolcore/deploy/.env (mode 600) and must never appear here or in Git.
# See docs/SECRET_MANAGEMENT_GUIDE.md.
#
# ---------------------------------------------------------------------------
# A. FRONTEND BUILD VARIABLES (VITE_*) — public by nature, baked into the
#    client bundle at build time. NEVER put a secret behind a VITE_ prefix.
# ---------------------------------------------------------------------------

# Convex backend the browser connects to.
#   Convex Cloud : provided by the platform
#   Self-hosted  : https://schoolcore-api.ooflowdesk.com
VITE_CONVEX_URL=

# Freebuff VLY observability integration (optional). Self-hosted deployments
# may leave these unset; the integration is skipped when absent.
VITE_VLY_APP_ID=
VITE_VLY_MONITORING_URL=

# ---------------------------------------------------------------------------
# B. CONVEX DEPLOYMENT ENVIRONMENT VARIABLES — server-side only, set via
#    `npx convex env set` (Cloud) or the self-hosted deployment env file.
#    These are NOT build-time and must never be prefixed VITE_.
# ---------------------------------------------------------------------------

# Public origin of this deployment's HTTP actions / OIDC discovery endpoint.
#   Self-hosted : https://schoolcore-site.ooflowdesk.com
# NOTE: do NOT set this to a localhost/5173 value. It becomes the auth issuer
# and must be publicly resolvable in the deployment you are targeting.
CONVEX_SITE_URL=

# Where the app redirects back to after an auth flow (OAuth / magic links).
SITE_URL=

# Convex Auth signing material. Generate fresh per deployment; never reuse
# from Convex Cloud, never commit. Procedure: docs/SELF_HOSTING_GUIDE.md
JWT_PRIVATE_KEY=
JWKS=

# Resend — the email transport for sign-in OTP (and the communications queue).
# Format: re_...  Server-side only.
RESEND_API_KEY=
# Sending address on a VERIFIED Resend sending domain, e.g.
#   SchoolCore <noreply@mail.schoolcore.example>
# If unset, the code falls back to Resend's onboarding address, which only
# permits delivery to the account owner's own mailbox. A verified sending
# domain is REQUIRED before sending production email to real users.
RESEND_FROM_EMAIL=

# Deployment used by `npx convex dev` (local development against a deployment)
CONVEX_DEPLOYMENT=

# ---------------------------------------------------------------------------
# C. DEPRECATED / TRANSITIONAL (Convex Cloud only — remove after cutover)
# ---------------------------------------------------------------------------

# Legacy Freebuff OTP gateway. Retained ONLY as a fallback for the existing
# Convex Cloud deployment. The self-hosted deployment sets RESEND_API_KEY and
# never requires this. Scheduled for deletion after production cutover.
# See docs/EMAIL_RESEND_MIGRATION.md.
VLY_EMAIL_OTP_API_KEY=

# Legacy email channel gate for the communications queue (Convex Cloud).
EMAIL_API_KEY=

# Opt-in Freebuff federated sign-in issuer. When unset, the customJwt provider
# is not registered at all, so self-hosted SchoolCore has no Freebuff
# dependency. When set, federated sign-in is enabled for that issuer.
VLY_CONVEX_AUTH_ISSUER=

# Legacy VLY integrations (AI). Leave unset on self-hosted.
VLY_INTEGRATION_KEY=
VLY_APP_NAME=
